<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:padding="20dp">

    <!-- 顶部标题 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰ 定时点击器"
        android:textSize="26sp"
        android:textColor="#1A1A2E"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="到时间自动点击指定按钮"
        android:textSize="14sp"
        android:textColor="#888888"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp" />

    <!-- 服务状态卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/service_stopped"
                android:textSize="15sp"
                android:textColor="#666666" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnableService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enable_accessibility"
                android:textSize="13sp"
                app:cornerRadius="20dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 设置卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardStatus">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 点击设置"
                android:textSize="16sp"
                android:textColor="#1A1A2E"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- 按钮文字 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/target_button_label"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:hintEnabled="false"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etButtonText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/target_button_hint"
                    android:text="确定"
                    android:textSize="16sp"
                    android:inputType="text"
                    android:singleLine="true"
                    android:padding="14dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- 时间选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/target_time_label"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <NumberPicker
                    android:id="@+id/npHour"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textSize="28sp"
                    android:textColor="#1A1A2E"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp" />

                <NumberPicker
                    android:id="@+id/npMinute"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textSize="28sp"
                    android:textColor="#1A1A2E"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp" />

                <NumberPicker
                    android:id="@+id/npSecond"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <!-- 提前量补偿 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 提前量补偿（应对手机时钟偏差）"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:hintEnabled="false"
                    app:suffixText="ms"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOffsetMs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="如 375"
                        android:text="0"
                        android:textSize="16sp"
                        android:inputType="number"
                        android:singleLine="true"
                        android:padding="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="    手机慢填正数，快填负数"
                    android:textSize="11sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- 预扫描提前量 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 预扫描提前量（提前唤醒锁定按钮）"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:hintEnabled="false"
                    app:suffixText="ms"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPreScanMs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="如 2000"
                        android:text="2000"
                        android:textSize="16sp"
                        android:inputType="number"
                        android:singleLine="true"
                        android:padding="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="    默认2000ms，太短来不及扫描"
                    android:textSize="11sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 操作按钮 -->
    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardSettings">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSchedule"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/schedule_button"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp" />

    </LinearLayout>

    <!-- 定时状态 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTaskStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llActions">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTaskStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="#4A90D9" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/cancel_button"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="#FF6B6B" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 执行日志 -->
    <TextView
        android:id="@+id/tvLogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📜 执行记录"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardTaskStatus" />

    <ScrollView
        android:id="@+id/svLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogTitle"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无执行记录"
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:lineSpacingExtra="4dp" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
